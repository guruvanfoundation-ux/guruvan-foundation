PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/guruvan

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Guruvan Foundation <info@guruvanfoundation.org>"
ORG_80G_NUMBER=PENDING_80G_APPROVAL

# Public base URL used in QR codes / certificate verify links (prod domain)
PUBLIC_URL=

# Admin auth — generate a hash: node -e "console.log(require('bcryptjs').hashSync('yourpass',10))"
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_EMAIL=admin@guruvanfoundation.org
ADMIN_PASSWORD_HASH=
STAFF_EMAIL=
STAFF_PASSWORD_HASH=
# Local dev only — set true to bypass admin auth while testing. NEVER in production.
AUTH_DISABLED=false
